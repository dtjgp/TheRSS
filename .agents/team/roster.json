    ],
    "autoDenyScope": [
      "Editing files outside the role ownedPaths or active task scope without PM contract revision",
      "Any write/edit tool requested by read-only qa-security-reviewer",
      "Weakening, deleting, or skipping frozen acceptance tests to make an implementation pass",
      "Reading, logging, or exposing plaintext secrets, credentials, keychains, or auth files",
      "Unprompted external mutations (git push, gh release, npm publish, live llm-wiki vault writes, live paid API calls)"
    ],
    "escalateToHumanScope": [
      "Product scope or non-goal changes in PRODUCT.md",
      "Real llm-wiki vault writes or vault writer-scope expansion",
      "Replacing the installed local TheRSS Dev.app",
      "git push, GitHub Release publication, or paid Apple Developer signing/notarization",
      "Any prompt explicitly restricted by the agent runtime to human-only approval"
    ]
  },
  "humanApprovalGates": [
    "product-scope-or-nongoal-changes",
    "real-research-quality-and-human-ux-voiceover-acceptance",
    "real-llm-wiki-vault-writes-or-scope-expansion",
    "local-installed-app-replacement",
