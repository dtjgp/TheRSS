{
  "name": "therss",
  "version": "0.2.0",
  "description": "A local-first semantic research discovery desk for 22 verified sources.",
  "type": "module",
  "main": "out/main/index.js",
  "author": "dtjgp",
  "license": "MIT",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && npm run build:mcp",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "smoke:credentials": "electron scripts/smoke-safe-storage.mjs",
    "smoke:mcp": "npm run build:mcp --silent && node scripts/smoke-mcp.mjs",
    "smoke:package": "node scripts/smoke-packaged-app.mjs",
    "smoke:sources": "tsx scripts/smoke-sources.ts",
    "smoke:configured-sources": "tsx scripts/smoke-configured-sources.ts",
    "mcp:serve": "node out/mcp/stdio.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "package:mac": "npm run build && electron-builder --mac dir",
    "install:local": "npm run package:mac && node scripts/install-local-beta.mjs",
    "update:local": "node scripts/update-local-beta.mjs",
    "postinstall": "node scripts/ensure-electron.mjs && electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "dev.dtjgp.therss",
    "productName": "TheRSS",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ]
    }
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
